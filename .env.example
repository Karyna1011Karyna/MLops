# Copy this file to .env before running docker compose:
#   cp .env.example .env

# ---- PostgreSQL (operational DB: incoming labeled training examples) ----
POSTGRES_USER=tarotrag
POSTGRES_PASSWORD=tarotrag_dev_pw
POSTGRES_DB=tarotrag
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---- MinIO (S3-compatible object storage: dataset versions + model artifacts) ----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
# Used by services running *inside* the docker network:
MINIO_ENDPOINT=http://minio:9000
MINIO_DATASETS_BUCKET=tarot-datasets
MINIO_MODELS_BUCKET=tarot-models

# ---- API ----
API_PORT=8000

# ---- MLflow (tracking server + model registry) ----
# Used by services running *inside* the docker network:
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_BACKEND_DB=mlflow
MLFLOW_ARTIFACTS_BUCKET=mlflow-artifacts
MLFLOW_MODEL_NAME=tarot-intent-classifier
MLFLOW_PORT=5000

# MLflow's own S3 client (and therefore the AWS SDK it wraps) reads these
# specific env-var names — keep the values in sync with MINIO_ROOT_USER /
# MINIO_ROOT_PASSWORD above if you change them.
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin123
MLFLOW_S3_ENDPOINT_URL=http://minio:9000

# ---- Champion/challenger serving ----
# % of /predict traffic routed to the challenger model, when one exists.
CHALLENGER_TRAFFIC_PCT=10
# How often each api replica re-checks the registry for alias changes.
MODEL_REFRESH_SECONDS=60
